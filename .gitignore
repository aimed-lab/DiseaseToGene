# Environment variables (never commit secrets)
.env
.env.local
.env.*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-server
dist-ssr
*.local
.claude/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Raw bulk downloads — huge; regenerate with scripts/build_*.mjs
xena_raw/
depmap_raw/
gnomad_raw/
gtex_raw/

# Runtime job state (the reference tables data/*.json ARE committed)
data/jobs.json

# Snapshot CSV dumps — regenerate with scripts/export_snapshot_csv.ts <id>
exports/

# Office lock files
~$*

# Unpublished manuscript — drafts, figures and result files.
# Deliberately untracked: the repo is public and this work is pre-submission.
manuscript/

# ── Non-code working files ────────────────────────────────────────────────────
# Policy: only code needed to run the app is tracked. Everything below is data,
# decks, generated output or session notes — kept locally, never pushed.

# Moved out of the repo root; raw GEO/TCGA downloads, case-study data, manuscript
# drafts. ~148 MB, and pre-submission material does not belong in a public repo.
assets/

# Generated decks, HTML reports and benchmark JSON — regenerate with scripts/.
deliverables/

# Root-level decks, spreadsheets and archives. Anchored to the root on purpose:
# docs/decks/ and documentation/ hold deliberately tracked files.
/*.pptx
/*.xlsx
/*.docx
/*.zip
/*.ipynb
/*.csv

# Per-session handoff notes. docs/HANDOFF.md (no underscore) stays tracked.
docs/HANDOFF_*.md
docs/CollaboFest_Phase0_User_Requirements.md
docs/Funnel_Design.md
docs/Funnel_Design_v2.md
docs/Funnel_Design_Review_Request.md
docs/Pocket_Druggability_Feature.md

# STRING flat files for the WINNER reference run — 83 MB, and the two curl
# lines in WINNER/README.md rebuild them exactly. The computed scores in
# WINNER/out/ ARE tracked, so the results are usable without this download.
WINNER/data/

# Cached Agora API response — refetched with AGORA_REFRESH=1.
# The joined table in AGORA/out/ IS tracked.
AGORA/data/

# AMP-AD brain proteomics, downloaded from Synapse by hand (free account required, and
# a data-use agreement). The built data/proteomics_ad.json IS tracked, same as the CPTAC
# proteomics_*.json files; these raw inputs are not.
data/Final_Agora_DE.csv
data/Final_Agora_DE_TMT.csv
data/SRMdata.csv
# AMP-AD RNA differential expression (Synapse syn27211942) — 175 MB, downloaded by hand.
# Not yet wired into any axis; ignored so a `git add -A` cannot push a file GitHub rejects.
data/differentialExpressionSummary.tsv

# WINNER run directories: regenerated by WINNER/scripts/build_graph.mjs (inputs are MBs)
WINNER/runs/

# Runtime AI usage counter (daily OpenAI budget) — state, not source
data/ai_usage.json
