# Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_RATE_LIMIT_MAX_REQUESTS=20

# NCBI API Key (PubMed)
NCBI_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Invite-only registration — users must enter this shared code to sign up.
# Leave blank to disable self-registration entirely.
SIGNUP_INVITE_CODE=
SUPABASE_API_CACHE_TABLE=external_api_cache
API_CACHE_TTL_SECONDS=86400
DISABLE_API_CACHE=0

# Production origin, e.g. https://your-app.vercel.app
ALLOWED_ORIGIN=

# ── Oracle (content store of record) ──────────────────────────────────────────
# Runtime app connects as DISEASE2TARGET_APP; tables live in DISEASE2TARGET_OWNER.
# Set ORACLE_USER to the OWNER account first to test, then switch to the APP account.
ORACLE_USER=DISEASE2TARGET_APP
ORACLE_PASSWORD=
ORACLE_CONNECT_STRING=sparc.informatics.uab.edu:1521/BIODB.INFORMATICS.UAB.EDU
ORACLE_SCHEMA=DISEASE2TARGET_OWNER
# Set to 1 to route snapshot storage through Oracle instead of Supabase.
# Required for ALL WRITES (harvest / save / delete) and needs network access to the DB.
USE_ORACLE_STORE=0

# ── ORDS (read-only Oracle over HTTPS) ────────────────────────────────────────
# Routes every READ through ORDS instead of node-oracledb, so the board loads with
# no VPN. Writes still take the Oracle path above. Setting both is the recommended
# local setup: ORDS for reads, Oracle for writes.
USE_ORDS=1
ORDS_BASE_URL=https://aimed.uab.edu/apex/d2towner
# Optional OAuth2 client credentials. Without them ORDS is called unauthenticated.
ORDS_CLIENT_ID=
ORDS_CLIENT_SECRET=
