# deploy/rc-cloud-harvest/env.example
# Copy to the repo root as .env on the VM:   cp deploy/rc-cloud-harvest/env.example .env && chmod 600 .env
# Names only. Values come from the store owner, out of band. Never commit .env.

# ── Oracle (required — the harvest writes here) ─────────────────────────────
ORACLE_USER=
ORACLE_PASSWORD=
# Easy Connect string, e.g. host:1521/service_name — the VM must have a route to this host/port
ORACLE_CONNECT_STRING=
# Only if the run user is not the schema owner
# ORACLE_SCHEMA=

# ── Pipeline tuning (optional; defaults are the ones used for every snapshot so far) ──
# STRING_MIN_SCORE=400
# STRING_DIR=WINNER/data
# KG_GENE_N=
# KG_NETWORK_N=

# ── Notifications (optional; used by bin/notify.sh) ─────────────────────────
# A token with issues:write on the repo, ideally from a bot account
# GITHUB_TOKEN=
# GITHUB_REPO=aimed-lab/DiseaseToGene
# The issue number that collects harvest reports
# NOTIFY_ISSUE=
